# Haunt Nexus: one container with sync, PostgreSQL and cloudflared.
HAUNT_SYNC_HOST=nexus.your-domain.example
HAUNT_SYNC_TRUSTED_CLIENT_ORIGINS=
HAUNT_SYNC_IMAGE=ghcr.io/example-git/haunt-sync:latest
# Named tunnel token from Cloudflare. Startup writes a private token file.
HAUNT_SYNC_TUNNEL_TOKEN=
# With no token, explicitly set true to use a disposable random public URL.
HAUNT_SYNC_QUICK_TUNNEL=false
# Optional: otherwise generated privately and kept in the data volume.
# If set, use 32-256 URL-safe characters. Never change it on an existing volume.
HAUNT_SYNC_DB_PASSWORD=
# Public signed release mirror; populated with scripts/import-sync-updates.py.
HAUNT_SYNC_UPDATES_PATH=../.local/sync-updates
# Optional existing TLS SMTP provider.
HAUNT_SYNC_SMTP_HOST=
HAUNT_SYNC_SMTP_PORT=587
HAUNT_SYNC_SMTP_USERNAME=
HAUNT_SYNC_SMTP_PASSWORD=
HAUNT_SYNC_MAIL_FROM=

# Optional local send-only relay (requires private TLS and DKIM files).
# COMPOSE_FILE=compose.yml:compose.mail.yml
# HAUNT_SYNC_MAIL_HOST=mail.nexus.your-domain.example
# HAUNT_SYNC_MAIL_DOMAIN=mail.nexus.your-domain.example
# HAUNT_SYNC_MAIL_TRUSTED_NETWORK=your-project-network-CIDR
# HAUNT_SYNC_MAIL_TLS_PATH=../.local/sync-mail/tls
# HAUNT_SYNC_MAIL_DKIM_PATH=../.local/sync-mail/dkim
